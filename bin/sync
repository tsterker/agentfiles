#!/bin/bash
# Puts a team repo's skills and rules in place for Claude Code, Codex, Cursor and OpenCode, for one person.
# Usage: bin/sync [--repo <path>] [--me <name>] [--clean]
set -euo pipefail

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$(printf '\033[1m') D=$(printf '\033[2m') R=$(printf '\033[31m') G=$(printf '\033[32m') Y=$(printf '\033[33m') C=$(printf '\033[36m') N=$(printf '\033[0m')
else B= D= R= G= Y= C= N=; fi
die() { echo "${R}sync: $*${N}" >&2; exit 1; }
section() { printf '\n%s── %s %s%s\n' "${2:-$B$C}" "$1" "$(printf '%*s' $((60 - ${#1})) '' | sed 's/ /─/g')" "$N"; }
command -v git >/dev/null || die "needs git on PATH; found none"
command -v jq >/dev/null || die "needs jq on PATH (macOS 15 and later ship /usr/bin/jq); found none"
case $HOME in *[[:space:]]*) die "expected a home folder without spaces; got '$HOME'" ;; esac
shopt -s dotglob   # globs include hidden entries, so nothing in a folder sync owns slips past it

STARTER=$(cd "$(dirname "$0")/.." && pwd -P)
FORMAT=v1                     # the one agentfiles.txt format this starter reads
LOCAL=$STARTER/.local         # me and the team repo, for this machine; gitignored
CACHE=$HOME/.cache/agentfiles
SKILL_DIRS="$HOME/.claude/skills $HOME/.agents/skills"
RULE_DIR=$HOME/.claude/rules
# What sync owns once you hand it over: every entry in these folders, and these whole files.
PLUGIN=.cursor/plugins/local/agentfiles-rules   # Cursor's agent SDK (T3 Code) reads rules only from plugins
OWNED_DIRS="$SKILL_DIRS $HOME/.codex/skills $HOME/.cursor/skills $HOME/.config/opencode/skills $RULE_DIR $HOME/.cursor/rules $HOME/.cursor/plugins/local"
OWNED_FILES="$HOME/.codex/AGENTS.md $HOME/.codex/AGENTS.override.md $HOME/.config/opencode/AGENTS.md $HOME/.claude/CLAUDE.md"
GUARD=.cursor/rules/agentfiles-cli-guard.mdc     # cursor-agent reads only ~/.cursor/rules, so it gets this alone
WRITTEN=".codex/AGENTS.md .config/opencode/AGENTS.md $PLUGIN $GUARD"
# Names the harnesses themselves put in the folders sync owns.
HARNESS_KEEP="synced .trash .system"   # Claude Code: claude.ai account skills, removed skills; Codex: built-in skills
TAB=$(printf '\t')
ME= REPO= CLEAN=

while [ $# -gt 0 ]; do
  case $1 in
    --me) [ $# -ge 2 ] || die "--me needs a name"; ME=$2; shift 2 ;;
    --repo) [ $# -ge 2 ] || die "--repo needs a path"; REPO=$2; shift 2 ;;
    --clean) CLEAN=1; shift ;;
    *) die "unknown argument '$1'; expected --repo <path>, --me <name> or --clean" ;;
  esac
done

# --- Who am I, and which team repo ------------------------------------------
saved() { [ ! -f "$LOCAL" ] || awk -v k="$1" '$1 == k { sub(/^[^ ]+ /, ""); print }' "$LOCAL"; }
ASKED=$ME$REPO   # set when this run names me or the repo, which may create folders
[ -n "$ME" ] || ME=$(saved me)
if [ -n "$REPO" ]; then
  case $REPO in "~/"*) REPO=$HOME/${REPO#"~/"} ;; esac
  [ -d "$REPO" ] || die "expected a git repo at $REPO; found no folder. Clone your team's project there first"
  TEAM=$(cd "$REPO" && pwd -P)
else
  TEAM=$(saved repo)
fi
[ -n "$TEAM" ] || die "which team repo? Run bin/sync --repo <path> --me <name> once"
[ -n "$ME" ] || die "who are you? Run bin/sync --me <name> once"
case $ME in [a-z0-9]*) ;; *) die "--me takes a name starting with a-z or 0-9; got '$ME'" ;; esac
case $ME in *[!a-z0-9._-]*) die "--me takes a name of a-z, 0-9, '.', '_' and '-'; got '$ME'" ;; esac
case $TEAM in *[[:space:]]*) die "expected a team repo path without spaces; got '$TEAM'" ;; esac
[ "$TEAM" != "$STARTER" ] || die "expected a team repo of its own; got the starter itself. Clone your team's project elsewhere"
[ -e "$TEAM/.git" ] || [ -d "$TEAM/.jj" ] || die "expected a git repo at $TEAM; found a plain folder. Clone your team's project there first"
printf 'me %s\nrepo %s\n' "$ME" "$TEAM" > "$LOCAL"

welcome=
if [ ! -f "$TEAM/shared/agentfiles.txt" ]; then
  [ -n "$REPO" ] || die "expected $TEAM/shared/agentfiles.txt; it's missing. Run bin/sync --repo $TEAM to create it"
  mkdir -p "$TEAM/shared" && cp "$STARTER/bin/templates/shared/agentfiles.txt" "$TEAM/shared/"
  welcome="Created shared/agentfiles.txt in $TEAM: what everyone on the team gets."
fi
MINE=$TEAM/people/$ME
if [ ! -d "$MINE" ]; then
  [ -n "$ASKED" ] || die "expected your folder people/$ME/ in $TEAM; it's missing. Run bin/sync --me $ME to create it"
  mkdir -p "$TEAM/people" && cp -R "$STARTER/bin/templates/person" "$MINE"
  find "$MINE" -type f -exec sed -i '' "s/{{me}}/$ME/g" {} +
  welcome="${welcome:+$welcome
  }Created people/$ME/. Make rules/me.md yours: add the names you go by."
fi
if [ -n "$welcome" ]; then
  section "Welcome"
  echo "  $welcome"
  echo "  Commit and push the team repo. When your agent does something you don't like, ask it why, then ask it to change that."
fi
[ -f "$MINE/agentfiles.txt" ] || die "expected people/$ME/agentfiles.txt in $TEAM; it's missing"

# Lines of a file, without comments, trailing comments and blank lines.
lines() { [ -f "$1" ] || return 0; sed -e 's/[[:space:]]*#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" | grep -v -e '^$' || true; }
tilde() { sed "s|$HOME|~|g"; }
has() { awk -F"$TAB" -v c="$2" -v v="$3" '$c == v {f = 1} END {exit !f}' "$1"; }   # has <file> <column> <value>
rel() { echo "$1" | sed -e "s|^$TEAM/||" -e "s|^$STARTER/|starter: |" -e "s|^$CACHE/git/|git: |" -e "s|^$CACHE/follow/|followed: |" -e "s|^$HOME|~|"; }

# --- Sources: what each one brings, then what it uses -------------------------
W=$(mktemp -d)   # this run's scratch files
trap 'rm -rf "$W"' EXIT
SRC=$W/sources SKL=$W/skills-found RUL=$W/rule-files INI=$W/inits-found OFFS=$W/offs KEEPS=$W/keeps USED=$W/presets-used FOLLOWED=$W/followed FETCHED=$W/fetched
touch "$SRC" "$SKL" "$RUL" "$INI" "$OFFS" "$KEEPS" "$USED" "$FOLLOWED" "$FETCHED"
GOT=

fetch_git() {   # fetch_git <url> <follow 0|1> <where>: sets GOT to the source's folder in the cache
  local url=$1 follow=$2 where=$3 repo rest ref sub base tmp sha
  case $url in https://*|ssh://*|git@*) ;; *) die "$where: 'git' expects an https or ssh URL; got '$url'" ;; esac
  case $url in
    */-/tree/*) repo=${url%%/-/tree/*}; rest=${url#*/-/tree/} ;;
    */tree/*)   repo=${url%%/tree/*};   rest=${url#*/tree/} ;;
    *)          repo=$url;              rest= ;;
  esac
  ref=${rest%%/*} sub=
  case $rest in */*) sub=${rest#*/} ;; esac
  [ -n "$ref" ] || [ "$follow" = 1 ] || die "$where: 'use git $url' names no tag or commit, so it would track the default branch. Link a /tree/<tag or commit>, or write 'follow git $url'"
  base=$(echo "$repo" | sed -e 's|^[a-z+]*://||' -e 's|^[^/]*@||' -e 's|:|/|' -e 's|\.git$||')@${ref:-HEAD}
  if [ "$follow" = 1 ]; then   # followed checkouts live apart, so a pinned line never reads one
    base=$CACHE/follow/$base
    echo "$url" >> "$FOLLOWED"
    if grep -qxF "$base" "$FETCHED"; then GOT=$base${sub:+/$sub}; [ -d "$GOT" ] || die "$where: no folder '$sub' in $repo at ${ref:-its default branch}"; return 0; fi
  else
    base=$CACHE/git/$base
    if [ -d "$base" ]; then GOT=$base${sub:+/$sub}; [ -d "$GOT" ] || die "$where: no folder '$sub' in $repo at $ref"; return 0; fi
    case $ref in *[!0-9a-f]*) sha= ;; *) sha=$( [ ${#ref} = 40 ] && echo 1 || true ) ;; esac
    if [ -z "$sha" ] && ! git ls-remote --exit-code "$repo" "refs/tags/$ref" >/dev/null 2>&1 < /dev/null; then
      ! git ls-remote --exit-code "$repo" "refs/heads/$ref" >/dev/null 2>&1 < /dev/null \
        || die "$where: 'use git' expects a tag or commit; '$ref' is a branch of $repo. Link a tag or commit, or write 'follow git $url'"
      die "$where: found no tag '$ref' in $repo (or couldn't reach it). A commit needs all 40 characters; a ref containing '/' isn't supported"
    fi
  fi
  tmp=$(mktemp -d "$W/fetch.XXXXXX")
  git -C "$tmp" init -q
  git -C "$tmp" fetch -q --depth 1 "$repo" "${ref:-HEAD}" < /dev/null || { rm -rf "$tmp"; die "$where: can't fetch '${ref:-HEAD}' from $repo"; }
  # symlinks become plain files holding their path, so a source can't link sync to your own files
  git -C "$tmp" -c core.symlinks=false checkout -q FETCH_HEAD || { rm -rf "$tmp"; die "$where: can't check out '${ref:-HEAD}' from $repo"; }
  rm -rf "$tmp/.git" "$base" && mkdir -p "$(dirname "$base")" && mv "$tmp" "$base"
  echo "$base" >> "$FETCHED"
  GOT=$base${sub:+/$sub}
  [ -d "$GOT" ] || die "$where: no folder '$sub' in $repo at ${ref:-its default branch}; a ref containing '/' isn't supported, use a tag or commit"
}

read_source() {   # read_source <folder> <label> <followed 0|1> [skill|person]
  local dir=$1 label=$2 followed=$3 only=${4:-} file where body line verb kind what n p found root
  has "$SRC" 1 "$dir" && return 0   # each source is read once
  echo "$dir$TAB$label$TAB$followed" >> "$SRC"
  if [ "$only" = skill ]; then echo "$(basename "$dir")$TAB$dir$TAB$label" >> "$SKL"; return 0; fi
  find "$dir" -name SKILL.md -not -path '*/.git/*' | while IFS= read -r p; do
    echo "$(basename "$(dirname "$p")")$TAB$(dirname "$p")$TAB$label"
  done >> "$SKL"
  for p in "$dir"/rules/*.md; do if [ -f "$p" ]; then echo "$p$TAB$label" >> "$RUL"; fi; done
  [ "$only" != person ] || return 0   # a colleague's init scripts and agentfiles.txt stay theirs
  for p in "$dir"/init/*.sh; do if [ -f "$p" ]; then echo "$(basename "$p")$TAB$p$TAB$label$TAB$followed" >> "$INI"; fi; done
  file=$dir/agentfiles.txt
  [ -f "$file" ] || return 0
  where=$(rel "$file") body=$(lines "$file") root=0
  [ "$file" != "$MINE/agentfiles.txt" ] && [ "$file" != "$TEAM/shared/agentfiles.txt" ] || root=1
  n=$(echo "$body" | awk '$1 == "format"' | wc -l | tr -d ' ')
  [ "$n" -le 1 ] || die "$where: expected one 'format' line; found $n"
  p=$(echo "$body" | awk '$1 == "format" {print $2}')
  [ -n "$p" ] || die "$where: expected a 'format $FORMAT' line; found none"
  [ "$p" = "$FORMAT" ] || die "$where: this file is format $p; this starter reads format $FORMAT. See $STARTER/CHANGELOG.md"
  while IFS= read -r line; do
    set -f; set -- $line; set +f
    verb=$1 kind=${2:-} what=${3:-}
    case $verb in
      format) continue ;;
      keep) [ $# = 2 ] || die "$where: expected 'keep <name>'; got '$line'"; echo "$kind" >> "$KEEPS"; continue ;;
      use|follow|off) [ $# = 3 ] || die "$where: expected '$verb <kind> <what>'; got '$line'" ;;
      *) die "$where: expected a line starting with use, follow, off, keep or format; got '$line'" ;;
    esac
    case $verb/$kind in
      use/preset)
        echo "$what" >> "$USED"
        ! echo "$OFF_PRESETS" | grep -qxF "$what" || continue
        if [ -d "$STARTER/presets/$what" ] && [ -d "$TEAM/presets/$what" ]; then
          die "$where: two presets named $what, the starter's and the team repo's presets/$what; rename the team's"
        elif [ -d "$STARTER/presets/$what" ]; then read_source "$STARTER/presets/$what" "preset $what" "$followed"
        elif [ -d "$TEAM/presets/$what" ]; then read_source "$TEAM/presets/$what" "preset $what" "$followed"
        else die "$where: found no preset '$what' in the starter's or the team repo's presets/"; fi ;;
      use/person)
        [ -d "$TEAM/people/$what" ] || die "$where: 'use person $what' expects people/$what/ in the team repo; it's missing"
        read_source "$TEAM/people/$what" "people/$what" "$followed" person ;;
      use/skill)
        found=$(find "$TEAM/people" -path "*/skills/*" -path "*/$what/SKILL.md" -not -path '*/.git/*')
        [ "$(echo "$found" | grep -c .)" = 1 ] || die "$where: 'use skill $what' expects one skill named $what in people/*/skills/; found $(echo "$found" | grep -c . || true)"
        read_source "$(dirname "$found")" "$(rel "$(dirname "$found")")" "$followed" skill ;;
      use/folder)
        case $what in "~/"*) p=$HOME/${what#"~/"} ;; /*) p=$what ;; *) die "$where: 'use folder' expects a path starting with ~/ or /; got '$what'" ;; esac
        [ -d "$p" ] || die "$where: 'use folder $what' found no folder there"
        read_source "$(cd "$p" && pwd -P)" "$what" "$followed" ;;
      use/git) fetch_git "$what" 0 "$where"; read_source "$GOT" "$what" "$followed" ;;
      follow/git) fetch_git "$what" 1 "$where"; read_source "$GOT" "$what" 1 ;;
      use/*) die "$where: 'use' takes preset, person, skill, folder or git; got '$kind'" ;;
      follow/*) die "$where: 'follow' takes only git; got '$kind'" ;;
      off/preset) [ "$root" = 1 ] || die "$where: 'off preset' works only in shared/ and people/<me>/; got it here" ;;
      off/skill|off/rule|off/init) echo "$kind$TAB$what$TAB$root$TAB$where" >> "$OFFS" ;;
      off/*) die "$where: 'off' takes skill, rule, init or preset; got '$kind'" ;;
    esac
  done <<< "$body"
}

# Presets turned off, which only shared/ and my own file can do; then everything both use.
OFF_PRESETS=$( { lines "$TEAM/shared/agentfiles.txt"; lines "$MINE/agentfiles.txt"; } | awk '$1 == "off" && $2 == "preset" {print $3}' | sort -u)
read_source "$TEAM/shared" shared 0
read_source "$MINE" "people/$ME" 0
read_source "$STARTER/bin/skills/agentfiles" core 0 skill   # the core, which nobody turns off

# --- Off: check my own lines, then drop what's off -----------------------------
offs() { awk -F"$TAB" -v k="$1" '$1 == k {print $2}' "$OFFS" | sort -u; }
RULENAMES=$W/rule-names   # rule name, file, label
while IFS="$TAB" read -r f label; do
  sed -n 's/^- \*\*\([^*]*\)\*\*:.*/\1/p' "$f" | while IFS= read -r n; do echo "$n$TAB$f$TAB$label"; done
done < "$RUL" > "$RULENAMES"
mine_offs=$(awk '$1 == "off" {print $2 "\t" $3}' <(lines "$MINE/agentfiles.txt"))
while IFS="$TAB" read -r kind name; do   # a team or preset line that matches nothing is theirs to tidy
  [ -n "$kind" ] || continue
  where="people/$ME/agentfiles.txt"
  case $kind in
    skill) [ "$name" != agentfiles ] || die "$where: 'off skill agentfiles': the core can't be turned off"
           has "$SKL" 1 "$name" || die "$where: 'off skill $name' matches no skill you'd get" ;;
    rule) has "$RULENAMES" 1 "$name" || die "$where: 'off rule $name' matches no rule you'd get" ;;
    init) has "$INI" 1 "$name" || die "$where: 'off init $name' matches no init script you'd get" ;;
    preset) grep -qxF "$name" "$USED" || die "$where: 'off preset $name' matches no preset you'd get" ;;
  esac
done <<< "$mine_offs"
OFF_SKILLS=$(offs skill) OFF_RULES=$(offs rule) OFF_INITS=$(offs init)

SKILLS=$W/skills   # name, folder
OFF=$OFF_SKILLS awk -F"$TAB" '   # through the environment: BSD awk rejects a -v value with a newline
  BEGIN { n = split(ENVIRON["OFF"], o, "\n"); for (i = 1; i <= n; i++) skip[o[i]] = 1 }
  skip[$1] && $3 != "core" { next }
  ($1 in dir) && dir[$1] != $2 { print "sync: two skills named " $1 ": from " from[$1] " and " $3 > "/dev/stderr"; bad = 1 }
  !($1 in dir) { dir[$1] = $2; from[$1] = $3; print $1 "\t" $2 }
  END { exit bad }' "$SKL" > "$SKILLS" || exit 1

OFF=$OFF_RULES awk -F"$TAB" '
  BEGIN { n = split(ENVIRON["OFF"], o, "\n"); for (i = 1; i <= n; i++) skip[o[i]] = 1 }
  skip[$1] { next }
  ($1 in from) && from[$1] != $2 { print "sync: two rules named " $1 ": in " $2 " and " from[$1] > "/dev/stderr"; bad = 1 }
  { from[$1] = $2 } END { exit bad }' "$RULENAMES" || exit 1
RULES=$W/rules   # link name, what the link points to, the text: the rule file, or a copy without the rules turned off
mkdir -p "$W/rule-copies"
while IFS="$TAB" read -r f label; do
  link=agentfiles-$(echo "$label" | sed -e 's|^[a-z+]*://||' -e 's|[^A-Za-z0-9._]\{1,\}|-|g' -e 's|^-||' -e 's|-$||')-$(basename "$f")
  drop=$(sed -n 's/^- \*\*\([^*]*\)\*\*:.*/\1/p' "$f" | grep -xF -f <(echo "$OFF_RULES"; echo) || true)
  if [ -z "$drop" ]; then echo "$link$TAB$f$TAB$f"; continue; fi
  echo "$drop" | awk '{print "- **" $0 "**:"}' > "$W/drop"
  awk 'NR == FNR {d[$0] = 1; next} { for (p in d) if (index($0, p) == 1) next; print }' "$W/drop" "$f" > "$W/rule-copies/$link"
  echo "$link$TAB$CACHE/rules/$link$TAB$W/rule-copies/$link"
done < "$RUL" > "$RULES"
awk -F"$TAB" '($1 in seen) { print "sync: two rule files would both be linked as " $1 "; rename one" > "/dev/stderr"; bad = 1 } { seen[$1] = 1 } END { exit bad }' "$RULES" || exit 1

INITS=$W/inits   # file name, script
OFF=$OFF_INITS awk -F"$TAB" '
  BEGIN { n = split(ENVIRON["OFF"], o, "\n"); for (i = 1; i <= n; i++) skip[o[i]] = 1 }
  skip[$1] { next }
  ($1 in f) && f[$1] != $2 { print "sync: two init scripts named " $1 ": from " from[$1] " and " $3 > "/dev/stderr"; bad = 1 }
  $4 == 1 { print "sync: " $3 " is followed, so its init script " $1 " would run whatever was pushed last. Write off init " $1 ", or pin it with use git" > "/dev/stderr"; bad = 1 }
  !($1 in f) { f[$1] = $2; from[$1] = $3; print $1 "\t" $2 }
  END { exit bad }' "$INI" > "$INITS" || exit 1

# --- Look at the harnesses first, changing nothing ---------------------------
KEEP=$(echo "$HARNESS_KEEP" | tr ' ' '\n'; sort -u "$KEEPS")
mkdir -p "$CACHE/written"
touch "$CACHE/links"
ours() {   # a link that still points where sync put it, or a file sync wrote that nobody changed since
  if [ -L "$1" ]; then
    grep -qxF "$1$TAB$(readlink "$1")" "$CACHE/links" || case $(readlink "$1") in "$STARTER"/*) true ;; *) false ;; esac
  else
    [ -e "$CACHE/written/${1#$HOME/}" ] && diff -rq -x .DS_Store "$1" "$CACHE/written/${1#$HOME/}" >/dev/null 2>&1
  fi
}
kept() { echo "$KEEP" | grep -qxF "$(basename "$1")"; }

FOREIGN=$W/foreign
for d in $OWNED_DIRS; do
  [ ! -L "$d" ] || die "expected a folder at $d; found a link to $(readlink "$d"). Move it, then run sync again"
  for p in "$d"/*; do
    { [ -e "$p" ] || [ -L "$p" ]; } && [ "$(basename "$p")" != .DS_Store ] || continue
    kept "$p" || ours "$p" || echo "$p"
  done
done > "$FOREIGN"
for f in $OWNED_FILES; do
  if [ -e "$f" ] || [ -L "$f" ]; then ours "$f" || echo "$f"; fi
done >> "$FOREIGN"

UNMANAGED=$W/unmanaged   # kind, file, name
{
  oc=$HOME/.config/opencode
  for d in "$HOME/.claude/agents" "$HOME/.codex/agents" "$HOME/.cursor/agents" "$oc/agent" "$oc/agents"; do
    [ ! -d "$d" ] || ls "$d" | sed "s|^|subagents$TAB$d$TAB|"
  done
  for d in "$oc/plugin" "$oc/plugins"; do [ ! -d "$d" ] || ls "$d" | sed "s|^|plugins$TAB$d$TAB|"; done
  json() { [ -f "$2" ] || return 0; jq -r "$3" "$2" 2>/dev/null | sed "s|^|$1$TAB$2$TAB|" || echo "$1$TAB$2$TAB(can't read it as JSON)"; }
  json hooks "$HOME/.claude/settings.json" '.hooks // {} | keys[]'
  json hooks "$HOME/.codex/hooks.json" '.hooks // {} | keys[]'
  json hooks "$HOME/.cursor/hooks.json" '.hooks // {} | keys[]'
  json subagents "$oc/opencode.json" '.agent // {} | keys[]'
  json "MCP servers" "$HOME/.claude.json" '.mcpServers // {} | keys[]'
  json "MCP servers" "$HOME/.cursor/mcp.json" '.mcpServers // {} | keys[]'
  json "MCP servers" "$HOME/.config/opencode/opencode.json" '.mcp // {} | keys[]'
  json plugins "$HOME/.claude/settings.json" '.enabledPlugins // {} | to_entries[] | select(.value) | .key'
  toml() {   # names of the enabled [<table>.<name>] entries in a TOML file
    [ ! -f "$3" ] || awk -v t="$2" '
      function flush() { if (n != "" && on) print n }
      /^\[/ { flush(); n = ""; on = 1; h = $0; sub(/[[:space:]]*$/, "", h)
              if (index(h, "[" t ".") == 1) { n = substr(h, length(t) + 3, length(h) - length(t) - 3)
                if (n !~ /"/ && n ~ /\./) n = ""; gsub(/"/, "", n) } }
      /^enabled[[:space:]]*=[[:space:]]*false/ { on = 0 }
      END { flush() }' "$3" | sed "s|^|$1$TAB$3$TAB|"
  }
  toml "MCP servers" mcp_servers "$HOME/.codex/config.toml"
  toml plugins plugins "$HOME/.codex/config.toml"
} > "$UNMANAGED"
if [ -s "$UNMANAGED" ]; then
  section "Not managed by sync"
  echo "  ${D}Also shapes your agents. Sync leaves these alone; an init script can manage them.${N}"
  sort -s -t"$TAB" -k1,1 "$UNMANAGED" | awk -F"$TAB" -v home="$HOME" -v d="$D" -v n0="$N" '
    { k = $1 "\t" $2; if (!(k in seen)) { seen[k] = 1; order[++n] = k } names[k] = names[k] (names[k] ? ", " : "") $3 }
    END { for (i = 1; i <= n; i++) { split(order[i], a, "\t"); f = a[2]; sub("^" home, "~", f)
            printf "  %-12s %s%s:%s", a[1], d, f, n0; w = 16 + length(f); k = split(names[order[i]], nm, ", ")
            for (j = 1; j <= k; j++) { if (w + length(nm[j]) > 100) { printf "\n%15s", ""; w = 15 }
              printf " %s%s", nm[j], (j < k ? "," : ""); w += length(nm[j]) + 2 }
            print "" } }'
fi

# --- Something in the way: show the plan, change nothing -------------------
if [ -s "$FOREIGN" ] && [ -z "$CLEAN" ]; then
  while IFS= read -r p; do   # where, what: a link's target, or folder/file
    case " $OWNED_FILES " in *" $p "*) at=$p ;; *) at=$(dirname "$p") ;; esac
    if [ -L "$p" ]; then what="-> $(readlink "$p")"; elif [ -d "$p" ]; then what=folder; else what=file; fi
    echo "$at$TAB$p$TAB$what"
  done < "$FOREIGN" | tilde > "$CACHE/plan.txt"
  n=$(wc -l < "$FOREIGN" | tr -d ' ')
  section "In the way" "$B$Y"
  echo "  $n $( [ "$n" = 1 ] && echo "thing in the folders sync owns isn't" || echo "things in the folders sync owns aren't" ) from sync:"
  awk -F"$TAB" '   # one line per place, counting links by the folder they point into
    { o = $3; if (o ~ /^-> /) { n = split(substr(o, 4), c, "/"); o = "link into " c[1] "/" c[2] "/" c[3] (c[1] == "" ? "/" c[4] : "") }
      if (!($1 in seen)) { seen[$1] = 1; at[++m] = $1 }
      if (!(($1, o) in cnt)) kinds[$1] = kinds[$1] "\t" o; cnt[$1, o]++ }
    END { for (i = 1; i <= m; i++) { k = split(substr(kinds[at[i]], 2), ks, "\t"); s = ""
            for (j = 1; j <= k; j++) { w = ks[j]; if (cnt[at[i], w] > 1) sub(/^[a-z]+/, "&s", w); s = s (j > 1 ? ", " : "") cnt[at[i], ks[j]] " " w }
            printf "  %-30s %s\n", at[i], s } }' "$CACHE/plan.txt"
  echo "  ${D}Each one, with where it points: ~/.cache/agentfiles/plan.txt${N}"

  section "What sync would set up"
  echo "  ${B}skills${N}  $(cut -f1 "$SKILLS" | sort | paste -sd ' ' -)"
  echo "  ${B}rules${N}   $(cut -f1 "$RULES" | sed 's/^agentfiles-//' | paste -sd ' ' -), for Claude Code, Codex, OpenCode and Cursor"

  section "Changed nothing" "$B$G"
  echo "  Nothing in your harnesses changed. Next:"
  echo "  - adjust people/$ME/agentfiles.txt (use, off, keep) and run ${B}bin/sync${N} again, or"
  echo "  - run ${B}bin/sync --clean${N}: it moves what's in the way to ~/.cache/agentfiles/removed-<date>/ and sets up."
  echo "  ${D}Text you added to a file sync writes, such as ~/.codex/AGENTS.md, belongs in people/$ME/rules/.${N}"
  exit 1
fi

# --- What sync puts in place: links, and files it writes ----------------------
LINKS=$W/links   # path, target
for d in $SKILL_DIRS; do awk -F"$TAB" -v d="$d" '{print d "/" $1 "\t" $2}' "$SKILLS"; done >> "$LINKS"
awk -F"$TAB" -v d="$RULE_DIR" '{print d "/" $1 "\t" $2}' "$RULES" >> "$LINKS"

kept_planned=$( { cut -f1 "$LINKS"; for w in $WRITTEN; do echo "$HOME/$w"; done; } | while IFS= read -r p; do kept "$p" && echo "$p"; done || true)
[ -z "$kept_planned" ] || die "a keep line names something sync puts in place: $(echo "$kept_planned" | tilde | paste -sd ' ' -); drop that keep line"

STAGE=$W/stage   # the written files, at their paths under ~
TEXT=$STAGE/.codex/AGENTS.md
mkdir -p "$STAGE/.codex" "$STAGE/.config/opencode" "$STAGE/$PLUGIN/.cursor-plugin" "$STAGE/$PLUGIN/rules" "$(dirname "$STAGE/$GUARD")"
cut -f3 "$RULES" | while IFS= read -r f; do cat "$f"; echo; done > "$TEXT"
cp "$TEXT" "$STAGE/.config/opencode/AGENTS.md"
printf '{"name":"agentfiles-rules","version":"1.0.0","description":"Rules from %s, written by bin/sync"}\n' "$TEAM" > "$STAGE/$PLUGIN/.cursor-plugin/plugin.json"
{ printf -- '---\nalwaysApply: true\n---\n\n- **agentfiles**: These are the agentfiles rules for %s.\n\n' "$ME"; cat "$TEXT"; } > "$STAGE/$PLUGIN/rules/agentfiles.mdc"
printf -- '---\nalwaysApply: true\n---\n\n- **agentfiles-missing**: When your context has no rule named **agentfiles**: start every reply with "⚠️ This harness gets none of your agentfiles rules (the cursor-agent CLI reads none). Use the Cursor IDE, T3 Code or another harness."\n' > "$STAGE/$GUARD"

# --- --clean: move aside what's in the way ------------------------------------
if [ -s "$FOREIGN" ]; then
  aside=$CACHE/removed-$(date +%Y-%m-%d-%H%M%S)
  while IFS= read -r p; do
    mkdir -p "$aside/$(dirname "${p#$HOME/}")" && mv "$p" "$aside/${p#$HOME/}"
  done < "$FOREIGN"
  section "Taking over" "$B$Y"
  echo "  Moved $(wc -l < "$FOREIGN" | tr -d ' ') things sync didn't make to $(echo "$aside" | tilde)/"
fi

# --- Put it in place ----------------------------------------------------------
mkdir -p $SKILL_DIRS "$RULE_DIR"
while IFS="$TAB" read -r p target; do   # remove my links that are no longer wanted
  cut -f1 "$LINKS" | grep -qxF "$p" || { [ -L "$p" ] && [ "$(readlink "$p")" = "$target" ] && rm "$p"; } || true
done < "$CACHE/links"
for d in $OWNED_DIRS; do   # links into the starter that sync no longer plans, from before it kept a list
  for p in "$d"/*; do
    [ -L "$p" ] && ! kept "$p" || continue
    case $(readlink "$p") in "$STARTER"/*) cut -f1 "$LINKS" | grep -qxF "$p" || rm "$p" ;; esac
  done
done
rm -rf "$CACHE/rules" && cp -R "$W/rule-copies" "$CACHE/rules"
while IFS="$TAB" read -r p target; do ln -sfn "$target" "$p"; done < "$LINKS"
cp "$LINKS" "$CACHE/links"
for w in $WRITTEN; do
  mkdir -p "$(dirname "$HOME/$w")" && rm -rf "${HOME:?}/$w" && cp -R "$STAGE/$w" "$HOME/$w"
done
rm -rf "$CACHE/written" && cp -R "$STAGE" "$CACHE/written"

# --- Init scripts ----------------------------------------------------------
if grep -q . "$INITS" || [ -n "$OFF_INITS" ]; then section "Init scripts"; fi
echo "$OFF_INITS" | while IFS= read -r name; do [ -z "$name" ] || echo "  ${D}○ $name (off)${N}"; done
while IFS="$TAB" read -r -u 3 name f; do   # fd 3, so a script that asks something reads your terminal
  ME=$ME REPO=$TEAM STARTER=$STARTER bash "$f" 3<&- || die "init script $(rel "$f") failed"
  echo "  ${G}✓${N} $(rel "$f")"
done 3< "$INITS"

# --- Report ---------------------------------------------------------------
offs=$( { echo "$OFF_SKILLS" | sed 's/$/ (skill)/'; echo "$OFF_RULES" | sed 's/$/ (rule)/'; echo "$OFF_PRESETS" | sed 's/$/ (preset)/'; } | grep -v '^ (' | paste -sd ',' - | sed 's/,/, /g' || true)
section "Synced" "$B$G"
echo "  $(wc -l < "$SKILLS" | tr -d ' ') skills and $(wc -l < "$RULES" | tr -d ' ') rule files for $ME from $(echo "$TEAM" | tilde)${offs:+ ${D}(off: $offs)${N}}. New ones load in a new chat."
sort -u "$FOLLOWED" | while IFS= read -r u; do echo "  ${Y}following${N} $u"; done
