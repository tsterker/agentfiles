#!/bin/bash
# Puts this repo's skills and rules in place for Claude Code, Codex, Cursor and OpenCode, for one person.
# Usage: bin/sync [--me <name>] [--clean]
set -euo pipefail

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$(printf '\033[1m') D=$(printf '\033[2m') R=$(printf '\033[31m') G=$(printf '\033[32m') Y=$(printf '\033[33m') C=$(printf '\033[36m') N=$(printf '\033[0m')
else B= D= R= G= Y= C= N=; fi
die() { echo "${R}sync: $*${N}" >&2; exit 1; }
section() { printf '\n%s── %s %s%s\n' "${2:-$B$C}" "$1" "$(printf '%*s' $((60 - ${#1})) '' | sed 's/ /─/g')" "$N"; }
command -v git >/dev/null || die "needs git on PATH; found none"
command -v jq >/dev/null || die "needs jq on PATH (macOS 15 and later ship /usr/bin/jq); found none"
case $HOME in *[[:space:]]*) die "expected a home folder without spaces; got '$HOME'" ;; esac
shopt -s dotglob   # globs include hidden entries, so nothing in a folder sync owns slips past it

REPO=$(cd "$(dirname "$0")/.." && pwd -P)
CACHE=$HOME/.cache/agentfiles
SKILL_DIRS="$HOME/.claude/skills $HOME/.agents/skills"
RULE_DIR=$HOME/.claude/rules
# What sync owns once you hand it over: every entry in these folders, and these whole files.
OWNED_DIRS="$SKILL_DIRS $HOME/.codex/skills $HOME/.cursor/skills $HOME/.config/opencode/skills $RULE_DIR $HOME/.cursor/rules $HOME/.cursor/plugins/local"
OWNED_FILES="$HOME/.codex/AGENTS.md $HOME/.codex/AGENTS.override.md $HOME/.config/opencode/AGENTS.md $HOME/.claude/CLAUDE.md"
PLUGIN=.cursor/plugins/local/agentfiles-rules   # Cursor's agent SDK (T3 Code) reads rules only from plugins
GUARD=.cursor/rules/agentfiles-cli-guard.mdc     # cursor-agent reads only ~/.cursor/rules, so it gets this alone
WRITTEN=".codex/AGENTS.md .config/opencode/AGENTS.md $PLUGIN $GUARD"
TAB=$(printf '\t')
ME= CLEAN=

while [ $# -gt 0 ]; do
  case $1 in
    --me) [ $# -ge 2 ] || die "--me needs a name"; ME=$2; shift 2 ;;
    --clean) CLEAN=1; shift ;;
    *) die "unknown argument '$1'; expected --me <name> or --clean" ;;
  esac
done

# --- Who am I -------------------------------------------------------------
if [ -n "$ME" ]; then
  case $ME in [a-z0-9]*) ;; *) die "--me takes a name starting with a-z or 0-9; got '$ME'" ;; esac
  case $ME in *[!a-z0-9._-]*) die "--me takes a name of a-z, 0-9, '.', '_' and '-'; got '$ME'" ;; esac
  echo "$ME" > "$REPO/.me"
  if [ ! -d "$REPO/people/$ME" ]; then
    cp -R "$REPO/bin/person-template" "$REPO/people/$ME"
    find "$REPO/people/$ME" -type f -exec sed -i '' "s/{{me}}/$ME/g" {} +
    section "Welcome"
    echo "  Created people/$ME/. Make rules/me.md yours: add the names you go by."
    echo "  When your agent does something you don't like, ask it why, then ask it to change that."
  fi
elif [ -f "$REPO/.me" ]; then
  ME=$(cat "$REPO/.me")
else
  die "who are you? Run bin/sync --me <name> once"
fi
MINE=$REPO/people/$ME
[ -d "$MINE" ] || die "expected your folder people/$ME/; it's missing. Run bin/sync --me $ME to create it"

# Lines of a list file, without comments, trailing comments and blank lines.
lines() { [ -f "$1" ] || return 0; sed -e 's/[[:space:]]*#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" | grep -v -e '^$' || true; }
tilde() { sed "s|$HOME|~|g"; }

# --- Look at the harnesses first, changing nothing ---------------------------
KEEP=$(lines "$REPO/shared/keep.txt"; lines "$MINE/keep.txt")
mkdir -p "$CACHE/written"
touch "$CACHE/links"
ours() {   # a link that still points where sync put it, or a file sync wrote that nobody changed since
  if [ -L "$1" ]; then
    grep -qxF "$1$TAB$(readlink "$1")" "$CACHE/links" || case $(readlink "$1") in "$REPO"/*) true ;; *) false ;; esac
  else
    [ -e "$CACHE/written/${1#$HOME/}" ] && diff -rq -x .DS_Store "$1" "$CACHE/written/${1#$HOME/}" >/dev/null 2>&1
  fi
}
kept() { echo "$KEEP" | grep -qxF "$(basename "$1")"; }

FOREIGN=$(mktemp)
for d in $OWNED_DIRS; do
  [ ! -L "$d" ] || die "expected a folder at $d; found a link to $(readlink "$d"). Move it, then run sync again"
  for p in "$d"/*; do
    { [ -e "$p" ] || [ -L "$p" ]; } && [ "$(basename "$p")" != .DS_Store ] || continue
    kept "$p" || ours "$p" || echo "$p"
  done
done > "$FOREIGN"
for f in $OWNED_FILES; do
  if [ -e "$f" ] || [ -L "$f" ]; then ours "$f" || echo "$f"; fi
done >> "$FOREIGN"

UNMANAGED=$(mktemp)   # kind, file, name
{
  oc=$HOME/.config/opencode
  for d in "$HOME/.claude/agents" "$HOME/.codex/agents" "$HOME/.cursor/agents" "$oc/agent" "$oc/agents"; do
    [ ! -d "$d" ] || ls "$d" | sed "s|^|subagents$TAB$d$TAB|"
  done
  for d in "$oc/plugin" "$oc/plugins"; do [ ! -d "$d" ] || ls "$d" | sed "s|^|plugins$TAB$d$TAB|"; done
  json() { [ -f "$2" ] || return 0; jq -r "$3" "$2" 2>/dev/null | sed "s|^|$1$TAB$2$TAB|" || echo "$1$TAB$2$TAB(can't read it as JSON)"; }
  json hooks "$HOME/.claude/settings.json" '.hooks // {} | keys[]'
  json hooks "$HOME/.codex/hooks.json" '.hooks // {} | keys[]'
  json hooks "$HOME/.cursor/hooks.json" '.hooks // {} | keys[]'
  json subagents "$oc/opencode.json" '.agent // {} | keys[]'
  json "MCP servers" "$HOME/.claude.json" '.mcpServers // {} | keys[]'
  json "MCP servers" "$HOME/.cursor/mcp.json" '.mcpServers // {} | keys[]'
  json "MCP servers" "$HOME/.config/opencode/opencode.json" '.mcp // {} | keys[]'
  json plugins "$HOME/.claude/settings.json" '.enabledPlugins // {} | to_entries[] | select(.value) | .key'
  toml() {   # names of the enabled [<table>.<name>] entries in a TOML file
    [ ! -f "$3" ] || awk -v t="$2" '
      function flush() { if (n != "" && on) print n }
      /^\[/ { flush(); n = ""; on = 1; h = $0; sub(/[[:space:]]*$/, "", h)
              if (index(h, "[" t ".") == 1) { n = substr(h, length(t) + 3, length(h) - length(t) - 3)
                if (n !~ /"/ && n ~ /\./) n = ""; gsub(/"/, "", n) } }
      /^enabled[[:space:]]*=[[:space:]]*false/ { on = 0 }
      END { flush() }' "$3" | sed "s|^|$1$TAB$3$TAB|"
  }
  toml "MCP servers" mcp_servers "$HOME/.codex/config.toml"
  toml plugins plugins "$HOME/.codex/config.toml"
} > "$UNMANAGED"
if [ -s "$UNMANAGED" ]; then
  section "Not managed by sync"
  echo "  ${D}Also shapes your agents. Sync leaves these alone; an init script can manage them.${N}"
  sort -s -t"$TAB" -k1,1 "$UNMANAGED" | awk -F"$TAB" -v home="$HOME" -v d="$D" -v n0="$N" '
    { k = $1 "\t" $2; if (!(k in seen)) { seen[k] = 1; order[++n] = k } names[k] = names[k] (names[k] ? ", " : "") $3 }
    END { for (i = 1; i <= n; i++) { split(order[i], a, "\t"); f = a[2]; sub("^" home, "~", f)
            printf "  %-12s %s%s:%s", a[1], d, f, n0; w = 16 + length(f); k = split(names[order[i]], nm, ", ")
            for (j = 1; j <= k; j++) { if (w + length(nm[j]) > 100) { printf "\n%15s", ""; w = 15 }
              printf " %s%s", nm[j], (j < k ? "," : ""); w += length(nm[j]) + 2 }
            print "" } }'
fi

# --- Which skills I get: name, folder, where from -------------------------
WANT=$(mktemp)
add_skills() {
  [ -d "$1" ] || return 0
  find "$1" -name SKILL.md -not -path '*/.git/*' | while IFS= read -r f; do
    d=$(dirname "$f"); echo "$(basename "$d")$TAB$d$TAB$2"
  done >> "$WANT"
}
collect_skills() {
  : > "$WANT"
  add_skills "$REPO/shared/skills" shared/skills
  add_skills "$REPO/shared/upstream" shared/upstream
  add_skills "$MINE/skills" "people/$ME/skills"
  add_skills "$MINE/upstream" "people/$ME/upstream"
  lines "$MINE/opt-in.txt" | while IFS= read -r line; do
    case $line in
      "~/"*|/*|.*)
        case $line in "~/"*) p=$HOME/${line#"~/"} ;; /*) p=$line ;; *) p=$MINE/$line ;; esac
        [ -d "$p" ] || die "opt-in.txt: no folder $p"
        add_skills "$p" "$line" ;;
      */*)
        person=${line%%/*} skill=${line#*/}
        [ -d "$REPO/people/$person/skills" ] || die "opt-in.txt: '$line' expects people/$person/skills/; it's missing"
        if [ "$skill" = '*' ]; then add_skills "$REPO/people/$person/skills" "$line"; continue; fi
        found=$(find "$REPO/people/$person/skills" -path "*/$skill/SKILL.md" | wc -l | tr -d ' ')
        [ "$found" = 1 ] || die "opt-in.txt: '$line' expects one skill '$skill' in people/$person/skills/; found $found"
        add_skills "$(dirname "$(find "$REPO/people/$person/skills" -path "*/$skill/SKILL.md")")" "$line" ;;
      *) die "opt-in.txt: '$line' is neither <person>/<skill>, <person>/* nor a folder path" ;;
    esac
  done
}
OFF=$(lines "$MINE/off.txt")
RULES=$(mktemp)   # link name, file
for f in "$REPO"/shared/rules/*.md; do if [ -f "$f" ]; then echo "agentfiles-shared-$(basename "$f")$TAB$f"; fi; done >> "$RULES"
for f in "$MINE"/rules/*.md; do if [ -f "$f" ]; then echo "agentfiles-$ME-$(basename "$f")$TAB$f"; fi; done >> "$RULES"
copied() { [ -f "$1/upstream/sources.txt" ] && awk -v l="$2" '$3 == l {f = 1} END {exit !f}' "$1/upstream/sources.txt"; }
UNCOPIED=$(for dir in "$REPO/shared" "$MINE"; do lines "$dir/upstream.txt" | while IFS= read -r l; do copied "$dir" "$l" || echo "$l"; done; done)

# --- Something in the way: show the plan, change nothing -------------------
if [ -s "$FOREIGN" ] && [ -z "$CLEAN" ]; then
  while IFS= read -r p; do   # where, what: a link's target, or folder/file
    case " $OWNED_FILES " in *" $p "*) at=$p ;; *) at=$(dirname "$p") ;; esac
    if [ -L "$p" ]; then what="-> $(readlink "$p")"; elif [ -d "$p" ]; then what=folder; else what=file; fi
    echo "$at$TAB$p$TAB$what"
  done < "$FOREIGN" | tilde > "$CACHE/plan.txt"
  n=$(wc -l < "$FOREIGN" | tr -d ' ')
  section "In the way" "$B$Y"
  echo "  $n $( [ "$n" = 1 ] && echo "thing in the folders sync owns isn't" || echo "things in the folders sync owns aren't" ) from this repo:"
  awk -F"$TAB" '   # one line per place, counting links by the folder they point into
    { o = $3; if (o ~ /^-> /) { n = split(substr(o, 4), c, "/"); o = "link into " c[1] "/" c[2] "/" c[3] (c[1] == "" ? "/" c[4] : "") }
      if (!($1 in seen)) { seen[$1] = 1; at[++m] = $1 }
      if (!(($1, o) in cnt)) kinds[$1] = kinds[$1] "\t" o; cnt[$1, o]++ }
    END { for (i = 1; i <= m; i++) { k = split(substr(kinds[at[i]], 2), ks, "\t"); s = ""
            for (j = 1; j <= k; j++) { w = ks[j]; if (cnt[at[i], w] > 1) sub(/^[a-z]+/, "&s", w); s = s (j > 1 ? ", " : "") cnt[at[i], ks[j]] " " w }
            printf "  %-30s %s\n", at[i], s } }' "$CACHE/plan.txt"
  echo "  ${D}Each one, with where it points: ~/.cache/agentfiles/plan.txt${N}"

  section "What sync would set up"
  collect_skills
  names=$(cut -f1 "$WANT" | sort -u | grep -vxF -f <(echo "$OFF"; echo) | paste -sd ' ' - || true)
  echo "  ${B}skills${N}  ${names:-none yet}"
  [ -z "$UNCOPIED" ] || echo "          ${D}plus the skills of $(echo "$UNCOPIED" | wc -l | tr -d ' ') upstream.txt lines, copied into this repo once nothing is in the way${N}"
  echo "  ${B}rules${N}   $(cut -f1 "$RULES" | sed 's/^agentfiles-//' | paste -sd ' ' -), for Claude Code, Codex, OpenCode and Cursor"

  section "Changed nothing" "$B$G"
  echo "  Nothing in your harnesses changed, and no upstream skills were copied. Next:"
  echo "  - adjust opt-in.txt, upstream.txt, keep.txt or off.txt in people/$ME/ and run ${B}bin/sync${N} again, or"
  echo "  - run ${B}bin/sync --clean${N}: it moves what's in the way to ~/.cache/agentfiles/removed-<date>/ and sets up."
  echo "  ${D}Text you added to a file sync writes, such as ~/.codex/AGENTS.md, belongs in people/$ME/rules/.${N}"
  rm -rf "$FOREIGN" "$UNMANAGED" "$WANT" "$RULES"
  exit 1
fi

# --- Upstream: copy each upstream.txt line into upstream/ -----------------
copy_upstream() {
  local dir=$1 out=$1/upstream sources=$1/upstream/sources.txt new
  new=$(mktemp)
  lines "$dir/upstream.txt" | while IFS= read -r line; do
    case $line in
      */-/tree/*) repo=${line%%/-/tree/*}; rest=${line#*/-/tree/} ;;
      */tree/*)   repo=${line%%/tree/*};   rest=${line#*/tree/} ;;
      *)          repo=$line;              rest= ;;
    esac
    ref=${rest%%/*} sub=
    case $rest in */*) sub=${rest#*/} ;; esac
    slug=$(echo "$repo" | sed -e 's|^[a-z+]*://||' -e 's|^[^/]*@||' -e 's|:|/|' -e 's|\.git$||')
    [ -z "$sub" ] || slug=$slug/$sub

    old=$( [ -f "$sources" ] && awk -v l="$line" '$3 == l' "$sources" || true )
    if [ -n "$old" ] && [ -d "$out/$slug" ]; then echo "$old" >> "$new"; continue; fi

    tmp=$(mktemp -d)
    git -C "$tmp" init -q
    git -C "$tmp" fetch -q --depth 1 "$repo" "${ref:-HEAD}" || die "can't fetch '${ref:-HEAD}' from $repo (${dir#$REPO/}/upstream.txt)${sub:+; if the ref contains '/', use a tag or sha instead}"
    git -C "$tmp" checkout -q FETCH_HEAD
    [ -d "$tmp/$sub" ] || die "no folder '$sub' at '$ref' in $repo; a ref containing '/' isn't supported, use a tag or sha"
    find "$tmp/$sub" -name SKILL.md -not -path '*/.git/*' | grep -q . || die "no SKILL.md under $line"
    rm -rf "${out:?}/$slug" && mkdir -p "$out/$slug"
    (cd "$tmp/$sub" && tar --exclude .git -cf - .) | (cd "$out/$slug" && tar -xf -)
    [ -z "$sub" ] || cp "$tmp"/LICENSE* "$out/$slug/" 2>/dev/null || true   # keep the licence notice with the copy
    echo "$slug $(git -C "$tmp" rev-parse HEAD) $line" >> "$new"
    rm -rf "$tmp"
    echo "  ${G}+${N} ${out#$REPO/}/$slug"
  done || return 1   # a line that failed stops here, before the copies below are pruned
  if [ -f "$sources" ]; then   # drop copies whose line is gone
    awk '{print $1}' "$sources" | while IFS= read -r slug; do
      awk -v s="$slug" '$1 == s {f = 1} END {exit !f}' "$new" || { rm -rf "${out:?}/$slug"; echo "  ${R}-${N} ${out#$REPO/}/$slug"; }
    done
  fi
  if [ -s "$new" ]; then mv "$new" "$sources"; else rm -f "$new" "$sources"; fi
  [ ! -d "$out" ] || find "$out" -type d -empty -delete
}
if [ -n "$UNCOPIED" ]; then
  section "Upstream"
  echo "  ${D}Copying $(echo "$UNCOPIED" | wc -l | tr -d ' ') upstream.txt lines into this repo (not your harnesses); commit them.${N}"
fi
copied_now=$(copy_upstream "$REPO/shared" && copy_upstream "$MINE") || { [ -z "$copied_now" ] || echo "$copied_now"; exit 1; }
if [ -n "$copied_now" ]; then [ -n "$UNCOPIED" ] || section "Upstream"; echo "$copied_now"; fi

# --- Init scripts, off and keep ----------------------------------------------
collect_skills
INITS=$(mktemp)   # name, script
for f in "$REPO"/shared/init/*.sh "$MINE"/init/*.sh; do if [ -f "$f" ]; then echo "$(basename "$f" .sh)$TAB$f"; fi; done > "$INITS"
both=$(cut -f1 "$INITS" | sort -u | grep -xF -f <(cut -f1 "$WANT") || true)
[ -z "$both" ] || die "a skill and an init script are both named '$(echo $both)'; rename one"
echo "$OFF" | while IFS= read -r name; do
  [ -z "$name" ] || cut -f1 "$WANT" "$INITS" | grep -qxF -- "$name" || die "off.txt: '$name' is no skill or init script you'd get"
done

SKILLS=$(mktemp)
OFF=$OFF awk -F"$TAB" '   # through the environment: BSD awk rejects a -v value with a newline
  BEGIN { n = split(ENVIRON["OFF"], o, "\n"); for (i = 1; i <= n; i++) skip[o[i]] = 1 }
  skip[$1] { next }
  ($1 in dir) && dir[$1] != $2 { print "sync: two skills named " $1 ": from " from[$1] " and " $3 > "/dev/stderr"; bad = 1 }
  !($1 in dir) { dir[$1] = $2; from[$1] = $3; print $1 "\t" $2 }
  END { exit bad }' "$WANT" > "$SKILLS" || exit 1

# --- What sync puts in place: links, and files it writes ----------------------
LINKS=$(mktemp)   # path, target
for d in $SKILL_DIRS; do awk -F"$TAB" -v d="$d" '{print d "/" $1 "\t" $2}' "$SKILLS"; done >> "$LINKS"
awk -F"$TAB" -v d="$RULE_DIR" '{print d "/" $1 "\t" $2}' "$RULES" >> "$LINKS"

kept_planned=$( { cut -f1 "$LINKS"; for w in $WRITTEN; do echo "$HOME/$w"; done; } | while IFS= read -r p; do kept "$p" && echo "$p"; done || true)
[ -z "$kept_planned" ] || die "keep.txt names something sync puts in place: $(echo "$kept_planned" | tilde | paste -sd ' ' -); drop it from keep.txt"

STAGE=$(mktemp -d)   # the written files, at their paths under ~
TEXT=$STAGE/.codex/AGENTS.md
mkdir -p "$STAGE/.codex" "$STAGE/.config/opencode" "$STAGE/$PLUGIN/.cursor-plugin" "$STAGE/$PLUGIN/rules" "$(dirname "$STAGE/$GUARD")"
cut -f2 "$RULES" | while IFS= read -r f; do cat "$f"; echo; done > "$TEXT"
cp "$TEXT" "$STAGE/.config/opencode/AGENTS.md"
printf '{"name":"agentfiles-rules","version":"1.0.0","description":"Rules from %s, written by bin/sync"}\n' "$REPO" > "$STAGE/$PLUGIN/.cursor-plugin/plugin.json"
{ printf -- '---\nalwaysApply: true\n---\n\n- **agentfiles**: These are the agentfiles rules for %s.\n\n' "$ME"; cat "$TEXT"; } > "$STAGE/$PLUGIN/rules/agentfiles.mdc"
printf -- '---\nalwaysApply: true\n---\n\n- **agentfiles-missing**: When your context has no rule named **agentfiles**: start every reply with "⚠️ This harness gets none of your agentfiles rules (the cursor-agent CLI reads none). Use the Cursor IDE, T3 Code or another harness."\n' > "$STAGE/$GUARD"

# --- --clean: move aside what's in the way ------------------------------------
if [ -s "$FOREIGN" ]; then
  aside=$CACHE/removed-$(date +%Y-%m-%d-%H%M%S)
  while IFS= read -r p; do
    mkdir -p "$aside/$(dirname "${p#$HOME/}")" && mv "$p" "$aside/${p#$HOME/}"
  done < "$FOREIGN"
  section "Taking over" "$B$Y"
  echo "  Moved $(wc -l < "$FOREIGN" | tr -d ' ') things sync didn't make to $(echo "$aside" | tilde)/"
fi

# --- Put it in place ----------------------------------------------------------
mkdir -p $SKILL_DIRS "$RULE_DIR"
while IFS="$TAB" read -r p target; do   # remove my links that are no longer wanted
  cut -f1 "$LINKS" | grep -qxF "$p" || { [ -L "$p" ] && [ "$(readlink "$p")" = "$target" ] && rm "$p"; } || true
done < "$CACHE/links"
for d in $OWNED_DIRS; do   # links into this repo that sync no longer plans
  for p in "$d"/*; do
    [ -L "$p" ] && ! kept "$p" || continue
    case $(readlink "$p") in "$REPO"/*) cut -f1 "$LINKS" | grep -qxF "$p" || rm "$p" ;; esac
  done
done
while IFS="$TAB" read -r p target; do ln -sfn "$target" "$p"; done < "$LINKS"
cp "$LINKS" "$CACHE/links"
for w in $WRITTEN; do
  mkdir -p "$(dirname "$HOME/$w")" && rm -rf "${HOME:?}/$w" && cp -R "$STAGE/$w" "$HOME/$w"
done
rm -rf "$CACHE/written" && cp -R "$STAGE" "$CACHE/written"

# --- Init scripts ----------------------------------------------------------
if grep -q . "$INITS"; then section "Init scripts"; fi
while IFS="$TAB" read -r -u 3 name f; do   # fd 3, so a script that asks something reads your terminal
  if echo "$OFF" | grep -qxF "$name"; then echo "  ${D}○ ${f#$REPO/} (off)${N}"; continue; fi
  ME=$ME REPO=$REPO bash "$f" 3<&- || die "init script ${f#$REPO/} failed"
  echo "  ${G}✓${N} ${f#$REPO/}"
done 3< "$INITS"

# --- Report ---------------------------------------------------------------
offs=$(echo "$OFF" | while IFS= read -r name; do [ -n "$name" ] || continue; if cut -f1 "$INITS" | grep -qxF -- "$name"; then echo "$name (init script)"; else echo "$name (skill)"; fi; done | paste -sd ',' - | sed 's/,/, /g')
section "Synced" "$B$G"
echo "  $(wc -l < "$SKILLS" | tr -d ' ') skills and $(wc -l < "$RULES" | tr -d ' ') rule files for $ME${offs:+ ${D}(off: $offs)${N}}. New ones load in a new chat."
rm -rf "$WANT" "$INITS" "$SKILLS" "$RULES" "$LINKS" "$STAGE" "$FOREIGN" "$UNMANAGED"
